# ==============================================================================
# PathForge Server Environment Configuration Example
# Copy this file to '.env' and fill in your real values.
# NEVER commit the active '.env' file containing real secrets to version control.
# ==============================================================================

# Server Network Port (Default: 5000)
PORT=5000

# JSON Web Token Secret Key (Use a cryptographically random string of 32+ characters)
JWT_SECRET=replace_with_your_strong_jwt_secret_in_production

# Persistent MongoDB Connection String (MongoDB Atlas or local MongoDB)
# Leave blank to use the embedded in-memory MongoDB engine for local development
MONGODB_URI=

# Pre-seed initial demo accounts and sample internships (true/false)
# Set to 'false' in production if you want an empty database
SEED_DEMO_DATA=true

# Allowed Client Origin for CORS and Socket.io
CLIENT_URL=http://localhost:5173

# Optional: Custom Production SMTP Email Alerts (Nodemailer)
# If left blank, PathForge uses Ethereal test accounts with preview links in development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
