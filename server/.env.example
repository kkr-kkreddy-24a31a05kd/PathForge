# ==============================================================================
# PathForge Server Environment Configuration Example
# Copy this file to '.env' for local development and fill in your values.
# Add these variables to Render Dashboard -> Environment Variables for production.
# NEVER commit the active '.env' file containing real secrets.
# ==============================================================================

# Server Network Port (Automatically provided by Render in production)
PORT=5000

# Node Environment ('production' on Render, 'development' locally)
NODE_ENV=production

# JSON Web Token Secret Key (Required for user authentication)
JWT_SECRET=

# MongoDB Connection String (MongoDB Atlas URI for production)
MONGODB_URI=

# Frontend Application URL for CORS & Socket.io (e.g. GitHub Pages or custom domain)
CLIENT_URL=https://kkr-kkreddy-24a31a05kd.github.io

# Seed initial demo accounts and listings on first start ('true' or 'false')
SEED_DEMO_DATA=true

# Optional: Custom SMTP Mailer Configuration (defaults to simulated logger if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
