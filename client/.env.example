# ==============================================================================
# PathForge Client Environment Configuration Example
# Copy this file to '.env' if custom client configuration is required.
# In Vite, variables exposed to the browser MUST start with VITE_
# NEVER put server secrets (passwords, private keys) in this file.
# ==============================================================================

# API Base URL (defaults to 'https://pathforge-api-ngmj.onrender.com/api' in production, or '/api' in dev)
VITE_API_URL=https://pathforge-api-ngmj.onrender.com/api

# Socket.io Server URL (defaults to 'https://pathforge-api-ngmj.onrender.com' in production, or 'http://localhost:5000' in dev)
VITE_SOCKET_URL=https://pathforge-api-ngmj.onrender.com
