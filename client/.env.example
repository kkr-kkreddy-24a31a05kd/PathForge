# ==============================================================================
# PathForge Client Environment Configuration Example
# Copy this file to '.env' if custom client configuration is required.
# In Vite, variables exposed to the browser MUST start with VITE_
# NEVER put server secrets (passwords, private keys) in this file.
# ==============================================================================

# API Base URL (leave empty if using Vite proxy /api)
VITE_API_URL=

# Socket.io Server URL (leave empty if using same origin or Vite proxy)
VITE_SOCKET_URL=
